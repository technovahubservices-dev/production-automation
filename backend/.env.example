PORT=5000
# Use a NEW local database. Do not put a production URI here.
MONGO_URI=mongodb://127.0.0.1:27018/starlit_local?replicaSet=starlit-local
JWT_SECRET=replace-with-a-long-random-login-secret
BIOMETRIC_INTEGRATION_ENABLED=true
# Same value as SecureVerify; generate at least 32 random characters.
BIOMETRIC_SERVICE_SECRET=replace-with-the-same-random-service-secret-in-both-apps
# Existing optional email settings remain supported; leave unset locally.
